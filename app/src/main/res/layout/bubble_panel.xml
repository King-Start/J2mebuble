<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bubble_panel_bg"
    android:padding="12dp"
    android:elevation="12dp"
    android:minWidth="200dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="J2ME Control"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_pause"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="⏸"
            android:textSize="18sp"
            android:background="@drawable/bubble_btn_bg" />

        <Button
            android:id="@+id/btn_soft1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="L"
            android:textSize="14sp"
            android:background="@drawable/bubble_btn_bg" />

        <Button
            android:id="@+id/btn_soft2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="R"
            android:textSize="14sp"
            android:background="@drawable/bubble_btn_bg" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btn_close_game"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="Exit Game"
            android:textSize="12sp"
            android:background="@drawable/bubble_btn_danger" />

        <Button
            android:id="@+id/btn_close_bubble"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="Hide Bubble"
            android:textSize="12sp"
            android:background="@drawable/bubble_btn_bg" />
    </LinearLayout>
</LinearLayout>
